            android:label="@string/inv_health_widget_title_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.duapharma.closingwidget.INVHEALTH_ACTION_REFRESH" />
