        </receiver>

        <service
            android:name=".InventoryReorderWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <receiver
            android:name=".InventoryExcessTopWidgetProvider"
            android:label="@string/inv_excess_top_widget_title_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.duapharma.closingwidget.INVEXCESSTOP_ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/inventory_excess_top_widget_info" />
        </receiver>

        <receiver
            android:name=".InventoryTopRunningWidgetProvider"
            android:label="@string/inv_top_running_widget_title_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.duapharma.closingwidget.INVTOPRUNNING_ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/inventory_top_running_widget_info" />
        </receiver>

        <receiver
            android:name=".InventorySearchWidgetProvider"
            android:label="@string/inv_search_widget_title_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
