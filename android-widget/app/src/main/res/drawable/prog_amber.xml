<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FFF59E0B" android:endColor="#FFFFD27A" /><corners android:radius="4dp" /></shape></clip>
    </item>
</layer-list>
