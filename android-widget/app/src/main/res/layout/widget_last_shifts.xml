<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/last_shifts_widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/last_shifts_widget_title"
        android:textColor="#0E8F72"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.02" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="@string/last_shifts_widget_subtitle"
        android:textColor="#8A8F98"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/last_shifts_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/last_shifts_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#B0B4BA"
        android:textSize="9sp" />

</LinearLayout>
