<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/inv_sv_widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/inv_dead_stock_widget_title"
        android:textColor="#C2410C"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.02" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="@string/inv_dead_stock_widget_subtitle"
        android:textColor="#8A8F98"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/inv_sv_listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#DCDFE3"
            android:dividerHeight="1px"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/inv_sv_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Loading…"
            android:textColor="#8A8F98"
            android:textSize="12sp" />

    </FrameLayout>

    <TextView
        android:id="@+id/inv_sv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#B0B4BA"
        android:textSize="9sp" />

</LinearLayout>
