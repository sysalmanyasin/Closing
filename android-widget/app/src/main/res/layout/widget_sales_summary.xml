<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/sales_widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sales_widget_title"
        android:textColor="#33363D"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/sales_latest_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sales_widget_loading"
        android:textColor="#8A8F98"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/sales_latest_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/sales_change_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#DCDFE3"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/sales_target_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sales_widget_loading"
        android:textColor="#8A8F98"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/sales_target_pct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#1A1C1F"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/sales_pace_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#8A8F98"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/sales_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#B0B4BA"
        android:textSize="9sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sales_widget_footer"
        android:textColor="#C7CBD1"
        android:textSize="9sp" />

</LinearLayout>
