<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BT SALE DATA  /  INTELLIGENCE"
            android:textColor="#FF087F8C"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Your business.\nOne clear view."
            android:textColor="#FF14213D"
            android:textSize="34sp"
            android:fontFamily="sans"
            android:lineSpacingExtra="0dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:text="Search stock, review closing, or ask Dua for a grounded briefing."
            android:textColor="#FF64748B"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_futuristic_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR CONTROL CENTER"
                android:textColor="#FF087F8C"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Sales · Closing · Credit · Inventory · STR"
                android:textColor="#FF14213D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="22 existing home-screen widgets remain available."
                android:textColor="#FF64748B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ai_briefing_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_violet"
                android:text="✦  AI Business Briefing"
                android:textAllCaps="false"
                android:textColor="#FF14213D"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <Button
                android:id="@+id/search_inventory_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_accent"
                android:text="⌕  Search Inventory"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <Button
                android:id="@+id/assistant_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:text="Quick Add  ·  Ask Dua"
                android:textAllCaps="false"
                android:textColor="#FF334155"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:text="↻  Refresh all widgets"
                android:textAllCaps="false"
                android:textColor="#FF334155"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_input_field">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA YOU CAN TRUST"
                android:textColor="#FF087F8C"
                android:textSize="10sp"
                android:letterSpacing="0.10"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Inventory Search is read-only. Ask Dua should flag unavailable data instead of guessing. Quick Add continues to use your authorized Google sign-in."
                android:textColor="#FF64748B"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tip: long-press your home screen → Widgets to add Closing Summary, Inventory Health, Reorder Now, and other shortcuts."
            android:textColor="#FF64748B"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
