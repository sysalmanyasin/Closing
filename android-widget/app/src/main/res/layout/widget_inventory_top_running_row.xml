<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/inv_run_row_rank"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/ink_400"
        android:textStyle="bold"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/inv_run_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/inv_run_row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/ink_500"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/inv_run_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/chip_info"
        android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:text="—"
        android:textColor="@color/status_info"
        android:textStyle="bold"
        android:textSize="12sp" />

</LinearLayout>
