<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/section_summary_widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_summary_widget_title"
        android:textColor="#33363D"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/section_summary_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/section_summary_widget_loading"
        android:textColor="#8A8F98"
        android:textSize="11sp" />

    <!-- Staff Credit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_label_staff_credit"
            android:textColor="#4B5058"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/section_staff_credit_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Jazz Cash -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_label_jazz_cash"
            android:textColor="#4B5058"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/section_jazz_cash_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Patty / Expenses -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_label_patty_expenses"
            android:textColor="#4B5058"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/section_patty_expenses_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Misc Sections -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_label_misc_sections"
            android:textColor="#4B5058"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/section_misc_sections_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#DCDFE3"
        android:orientation="vertical" />

    <!-- Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_label_total"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/section_total_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/section_summary_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#B0B4BA"
        android:textSize="9sp" />

</LinearLayout>
