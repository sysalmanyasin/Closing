<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:elevation="2dp"
    android:id="@+id/section_summary_widget_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/badge_circle_credit">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="center" android:src="@drawable/ic_layers" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/section_summary_widget_title"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <TextView
        android:id="@+id/section_summary_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/section_summary_widget_loading"
        android:textColor="@color/ink_500"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/section_label_staff_credit" android:textColor="@color/ink_700" android:textSize="13sp" />
        <TextView android:id="@+id/section_staff_credit_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/section_label_jazz_cash" android:textColor="@color/ink_700" android:textSize="13sp" />
        <TextView android:id="@+id/section_jazz_cash_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/section_label_patty_expenses" android:textColor="@color/ink_700" android:textSize="13sp" />
        <TextView android:id="@+id/section_patty_expenses_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/section_label_misc_sections" android:textColor="@color/ink_700" android:textSize="13sp" />
        <TextView android:id="@+id/section_misc_sections_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tile_credit_soft"
        android:padding="10dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/section_label_total" android:textColor="@color/accent_credit_dark" android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/section_total_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/accent_credit_dark" android:textStyle="bold" android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/section_summary_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/ink_400"
        android:textSize="9sp" />

</LinearLayout>
