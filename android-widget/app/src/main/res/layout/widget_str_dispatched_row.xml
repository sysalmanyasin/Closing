<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row_background"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/str_row_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/str_row_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_info"
            android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:text="—"
            android:textColor="@color/status_info"
            android:textStyle="bold"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/str_row_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textColor="@color/ink_500"
        android:textSize="10sp"
        android:ellipsize="end"
        android:maxLines="2" />

</LinearLayout>
