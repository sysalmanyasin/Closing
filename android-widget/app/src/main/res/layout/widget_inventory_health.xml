<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:elevation="2dp"
    android:id="@+id/inv_health_widget_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/badge_circle_inventory">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="center" android:src="@drawable/ic_box" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/inv_health_widget_title"
            android:textColor="@color/ink_900"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="14dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/inv_label_never_sold" android:textColor="@color/ink_700" android:textSize="12sp" />
        <TextView android:id="@+id/inv_never_sold_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/chip_negative" android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="—" android:textColor="@color/status_negative" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/inv_label_dead_stock" android:textColor="@color/ink_700" android:textSize="12sp" />
        <TextView android:id="@+id/inv_dead_stock_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/chip_negative" android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="—" android:textColor="@color/status_negative" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/hairline" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/inv_label_excess_raw" android:textColor="@color/ink_700" android:textSize="12sp" />
        <TextView android:id="@+id/inv_excess_raw_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/chip_warning" android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="—" android:textColor="@color/status_warning" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical"
        android:background="@drawable/tile_inventory_soft" android:padding="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/inv_label_excess_corrected" android:textColor="@color/accent_inventory_dark" android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/inv_excess_corrected_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/accent_inventory_dark" android:textStyle="bold" android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/inv_health_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/ink_400"
        android:textSize="9sp" />

</LinearLayout>
