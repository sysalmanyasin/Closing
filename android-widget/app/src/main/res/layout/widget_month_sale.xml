<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/month_sale_widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/month_sale_widget_title"
        android:textColor="#33363D"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/month_sale_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/month_sale_widget_loading"
        android:textColor="#8A8F98"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/month_sale_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#1A1C1F"
        android:textStyle="bold"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#DCDFE3"
        android:orientation="vertical" />

    <!-- Row 1: Cash | Banks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_grid_background"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/month_sale_label_cash"
                android:textColor="#8A8F98"
                android:textStyle="bold"
                android:textSize="10sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/month_sale_cash_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="#1A1C1F"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_grid_background"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/month_sale_label_banks"
                android:textColor="#8A8F98"
                android:textStyle="bold"
                android:textSize="10sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/month_sale_banks_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="#1A1C1F"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Cash & Banks | Credit Clients -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_grid_background"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/month_sale_label_cashbanks"
                android:textColor="#8A8F98"
                android:textStyle="bold"
                android:textSize="10sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/month_sale_cashbanks_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="#1A1C1F"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_grid_background"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/month_sale_label_credit"
                android:textColor="#8A8F98"
                android:textStyle="bold"
                android:textSize="10sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/month_sale_credit_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="—"
                android:textColor="#1A1C1F"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Customers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_grid_background"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/month_sale_label_customers"
            android:textColor="#8A8F98"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/month_sale_customers_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="—"
            android:textColor="#1A1C1F"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/month_sale_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#B0B4BA"
        android:textSize="9sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/month_sale_widget_footer"
        android:textColor="#C7CBD1"
        android:textSize="9sp" />

</LinearLayout>
