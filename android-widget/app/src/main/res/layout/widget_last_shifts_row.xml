<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row_background"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/ls_row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="—"
        android:textColor="@color/ink_900"
        android:textStyle="bold"
        android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ls_label_cash" android:textColor="@color/ink_500" android:textSize="10sp" />
        <TextView android:id="@+id/ls_row_cash" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ls_label_prev" android:textColor="@color/ink_500" android:textSize="10sp" />
        <TextView android:id="@+id/ls_row_prev" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ls_label_net_committed" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="11sp" />
        <TextView android:id="@+id/ls_row_net_committed" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/accent_closing" android:textStyle="bold" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ls_label_target" android:textColor="@color/ink_500" android:textSize="10sp" />
        <TextView android:id="@+id/ls_row_target" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/ink_900" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/hairline" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ls_row_diff_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="—" android:textColor="@color/ink_900" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/ls_row_diff" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
