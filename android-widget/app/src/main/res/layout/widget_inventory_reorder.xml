<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:elevation="2dp"
    android:id="@+id/inv_reorder_widget_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/badge_circle_negative">
            <ImageView android:layout_width="15dp" android:layout_height="15dp"
                android:layout_gravity="center" android:src="@drawable/ic_box" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="@string/inv_reorder_widget_title"
            android:textColor="@color/status_negative"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp"
        android:text="@string/inv_reorder_widget_subtitle"
        android:textColor="@color/ink_500"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/inv_reorder_listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/hairline"
            android:dividerHeight="1px"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/inv_reorder_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Loading…"
            android:textColor="@color/ink_500"
            android:textSize="12sp" />

    </FrameLayout>

    <TextView
        android:id="@+id/inv_reorder_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/ink_400"
        android:textSize="9sp" />

</LinearLayout>
